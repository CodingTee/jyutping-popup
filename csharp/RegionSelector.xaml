<Window x:Class="JyutPingPopup.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Cursor="Cross" Title="截图识字" Background="Black">
    <!-- 背景是按下热键那一刻拍下的全屏快照：既让遮罩一眼可见，
         又保证识别时用的是快照裁剪，遮罩自身不会被拍进结果里。 -->
    <Grid x:Name="Root">
        <Image x:Name="Bg" Stretch="Fill" IsHitTestVisible="False"/>
        <Rectangle x:Name="DimLayer" Fill="#A6000000" IsHitTestVisible="False"/>
        <!-- 选区内把快照再画一遍（按选框裁剪），于是选区是原亮度、外面是暗的 -->
        <Image x:Name="SelImg" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Canvas x:Name="DrawCanvas" IsHitTestVisible="False">
            <Border x:Name="SelRect" Visibility="Collapsed"
                    BorderBrush="#2B7FFF" BorderThickness="2"/>
        </Canvas>
        <Canvas x:Name="HintCanvas" IsHitTestVisible="False">
            <Border x:Name="HintBox" Background="#D9000000" CornerRadius="6" Padding="16,9">
                <StackPanel>
                    <TextBlock Text="拖框选中要识别的中文，松开即标粤拼"
                               Foreground="White" FontSize="14"/>
                    <TextBlock Text="Esc 或 ✕ 取消"
                               Foreground="#B5B5B5" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Canvas>
        <!-- 提示条右侧的关闭按钮：参考 Snipping Tool，点一下即取消。
             这个 Canvas 必须可命中（IsHitTestVisible 默认 True），按钮才能点。
             其余遮罩层都 IsHitTestVisible=False，所以只有按钮这一小块会拦下鼠标。 -->
        <Canvas x:Name="TopRightCanvas">
            <Border x:Name="CloseButton" Width="34" Height="34" CornerRadius="6"
                    BorderBrush="#66FFFFFF" BorderThickness="1"
                    Cursor="Arrow"
                    PreviewMouseLeftButtonDown="CloseButton_PreviewMouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#D9000000"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6404040"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="✕" Foreground="White" FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
