<Window x:Class="JyutPingPopup.OcrPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="300" MinWidth="280" MinHeight="160"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" Title="截图识字">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="截图识字结果" FontSize="15" FontWeight="Bold"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Row="1" x:Name="RawText" Margin="0,8,0,6" TextWrapping="Wrap"
                   FontSize="12" Foreground="#666666"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Cells" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</Window>
