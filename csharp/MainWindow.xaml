<Window x:Class="JyutPingPopup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="粤语拼音弹窗"
        Width="460"
        MinHeight="200"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/assets/logo.ico" Width="40" Height="40"/>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="粤语拼音弹窗" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Text="运行中 · 划选汉字松手即弹粤拼" FontSize="11" Foreground="#666666" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,4,0" Padding="8" Background="#F5F5F5" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="全局关闭" FontSize="11" Foreground="#888888" HorizontalAlignment="Center"/>
                    <Button x:Name="OffBtn" Content="全局关闭" Height="28" Margin="0,5,0,3" Click="OffBtn_Click"/>
                    <TextBlock x:Name="QuitHotkeyText" Text="Ctrl + Shift + Q" FontSize="10.5" Foreground="#555555" HorizontalAlignment="Center"/>
                    <Button x:Name="QuitCustomBtn" Content="自定义" Width="64" Height="22" HorizontalAlignment="Center" Margin="0,4,0,0" Click="QuitCustomBtn_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="4,0,4,0" Padding="8" Background="#F5F5F5" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="暂停捕获" FontSize="11" Foreground="#888888" HorizontalAlignment="Center"/>
                    <Button x:Name="PauseBtn" Content="暂停捕获" Height="28" Margin="0,5,0,3" Click="PauseBtn_Click"/>
                    <TextBlock x:Name="PauseHotkeyText" Text="Ctrl + Shift + P" FontSize="10.5" Foreground="#555555" HorizontalAlignment="Center"/>
                    <Button x:Name="PauseCustomBtn" Content="自定义" Width="64" Height="22" HorizontalAlignment="Center" Margin="0,4,0,0" Click="PauseCustomBtn_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="4,0,0,0" Padding="8" Background="#F5F5F5" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="截图识字" FontSize="11" Foreground="#888888" HorizontalAlignment="Center"/>
                    <Button x:Name="OcrBtn" Content="截图识字" Height="28" Margin="0,5,0,3" Click="OcrBtn_Click"/>
                    <TextBlock x:Name="OcrHotkeyText" Text="Ctrl + Shift + L" FontSize="10.5" Foreground="#555555" HorizontalAlignment="Center"/>
                    <Button x:Name="OcrCustomBtn" Content="自定义" Width="64" Height="22" HorizontalAlignment="Center" Margin="0,4,0,0" Click="OcrCustomBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="2,5,0,0" TextWrapping="Wrap" FontSize="10.5" Foreground="#888888"
                   Text="截图识字：图片、视频、游戏、扫描版 PDF 里选不中文字时，用它识别画面中的中文。"/>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="ResidentBox" Content="常驻后台"
                              ToolTipService.ToolTip="关窗口最小化到托盘，不退出"
                              Checked="ResidentBox_Changed" Unchecked="ResidentBox_Changed"/>
                    <CheckBox x:Name="ClipFallbackBox" Content="剪贴板兜底" Margin="0,7,0,0"
                              ToolTipService.ToolTip="读不到时借剪贴板；取消勾选则完全不碰剪贴板"
                              Checked="ClipFallbackBox_Changed" Unchecked="ClipFallbackBox_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="AutoStartBox" Content="开机自启"
                              ToolTipService.ToolTip="开机自动启动"
                              Checked="AutoStartBox_Changed" Unchecked="AutoStartBox_Changed"/>
                    <CheckBox x:Name="SpeakBox" Content="发音按钮（默认关闭）" Margin="0,7,0,0"
                              ToolTipService.ToolTip="在粤拼卡片上显示「朗读」按钮"
                              Checked="SpeakBox_Changed" Unchecked="SpeakBox_Changed">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </StackPanel>
            </Grid>

            <Border x:Name="SpeakNoVoiceHint" Margin="18,6,0,0" Padding="8" Background="#FFF4E6" CornerRadius="4" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00"
                               Text="未检测到粤语语音包，朗读按钮不会显示。"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap">
                        <Hyperlink Click="InstallVoice_Click" Foreground="#0066CC">点此打开系统设置安装语音包</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00"
                               Text="或手动：设置 → 时间和语言 → 语言和区域 → 添加语言 → 中文（繁体，香港）→ 勾选「文字转换语音」→ 装完重启本软件。"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="10.5" Foreground="#888888"
                       Text="自定义：点按钮后按新组合键，Esc 取消；单独按 Ctrl / Shift / Alt 也能成键。"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <Button x:Name="RestoreBtn" Content="恢复默认热键" Width="110" Height="26" Click="RestoreBtn_Click"/>
                <Button x:Name="HideBtn" Content="隐藏" Width="64" Height="26" Margin="8,0,0,0" Click="HideBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
