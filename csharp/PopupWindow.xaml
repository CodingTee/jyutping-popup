<Window x:Class="JyutPingPopup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="粤拼"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">
    <!-- 点击穿透的分工（关键，别乱改）：
         Window Background=null + 卡片 Border IsHitTestVisible=False => 卡片区鼠标穿透到下层应用；
         只有发音按钮 IsHitTestVisible=True => 整窗仅这一小块能收鼠标。
         父元素设 False 会连子树一起剪掉，所以按钮必须是 Card 的兄弟节点，不能塞进 Card 里。 -->
    <Grid x:Name="Root">
        <Border x:Name="Card" Background="#FFFFFF"
                BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="10" Padding="12,10"
                IsHitTestVisible="False">
            <StackPanel>
                <WrapPanel x:Name="Cells" MaxWidth="436" />
                <TextBlock x:Name="Footer"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="#8A8A8A"
                           TextWrapping="Wrap"
                           MaxWidth="436" />
                <!-- 发音按钮的等高占位：按钮浮在卡片右下角，这行给它留出空间，不压住 footer 文字 -->
                <Border x:Name="SpeakSpacer" Height="24" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Border x:Name="SpeakBtn" Width="52" Height="22" CornerRadius="11"
                Background="#EEF3FB" BorderBrush="#B9D4F5" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"
                Visibility="Collapsed" Cursor="Hand" IsHitTestVisible="True"
                PreviewMouseLeftButtonDown="SpeakBtn_PreviewMouseLeftButtonDown"
                ToolTip="朗读这段粤语（需本机安装粤语语音）">
            <TextBlock Text="朗读" FontSize="11" Foreground="#185FA5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
