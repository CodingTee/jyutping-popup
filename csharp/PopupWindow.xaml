<Window x:Class="JyutPingPopup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="粤拼"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">
    <Border Background="#FFFFFF"
            BorderBrush="#D9D9D9"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10">
        <StackPanel>
            <WrapPanel x:Name="Cells" MaxWidth="436" />
            <TextBlock x:Name="Footer"
                       Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="#8A8A8A"
                       TextWrapping="Wrap"
                       MaxWidth="436" />
        </StackPanel>
    </Border>
</Window>
